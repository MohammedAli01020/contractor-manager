# انسخ هذا الملف إلى .env ثم غيّر القيم. لا ترفع .env إلى Git أبدًا.
MYSQL_DATABASE=contractor
MYSQL_USER=contractor_app
MYSQL_PASSWORD=change_me_app_password
MYSQL_ROOT_PASSWORD=change_me_root_password
API_PORT=8080

# سر توقيع الجلسات (JWT): 32 حرفًا على الأقل، عشوائي وسري.
# لتوليده في PowerShell:
#   $b = New-Object byte[] 48; [System.Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
APP_JWT_SECRET=change_me_generate_a_long_random_secret

# مفتاح تشفير سر TOTP المخزّن في قاعدة البيانات؛ احتفظ به خارج Git وبنفس القيمة بعد إعادة التشغيل.
# استخدم قيمة عشوائية طويلة، ولا تستخدم APP_JWT_SECRET نفسه.
APP_PLATFORM_TOTP_ENCRYPTION_KEY=replace_with_a_private_random_secret_at_least_32_chars

# التسجيل العام مغلق افتراضيًا؛ افتحه صراحةً فقط عند الحاجة.
APP_REGISTRATION_ENABLED=false

# Swagger مغلق افتراضيًا؛ فعّله محليًا أثناء التطوير بوضع true في ملف .env الخاص بك.
SWAGGER_ENABLED=false

# Gmail SMTP: create a Google App Password after enabling 2-Step Verification.
# Keep real credentials in your local .env only; never commit them.
APP_EMAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-account@gmail.com
MAIL_APP_PASSWORD=replace_with_google_app_password
MAIL_FROM=your-account@gmail.com
# Set this to the public HTTPS activation page in production.
APP_PLATFORM_ACTIVATION_BASE_URL=https://your-domain.example/activate-admin/index.html
APP_PLATFORM_ACTIVATION_HOURS=24
# Development-only fallback that returns the activation URL in the API response.
APP_PLATFORM_ACTIVATION_LINK_RETURN_ENABLED=false
