# انسخ هذا الملف إلى .env ثم غيّر القيم. لا ترفع .env إلى Git أبدًا.
MYSQL_DATABASE=contractor
MYSQL_USER=contractor_app
MYSQL_PASSWORD=change_me_app_password
MYSQL_ROOT_PASSWORD=change_me_root_password
API_PORT=8080

# سر توقيع الجلسات (JWT): 32 حرفًا على الأقل، عشوائي وسري.
# لتوليده في PowerShell:
#   $b = New-Object byte[] 48; [System.Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
APP_JWT_SECRET=change_me_generate_a_long_random_secret

# السماح بتسجيل مقاولين جدد من الإنترنت (false لإغلاق التسجيل)
APP_REGISTRATION_ENABLED=true

# إظهار Swagger (اجعلها false عند النشر العام)
SWAGGER_ENABLED=true
