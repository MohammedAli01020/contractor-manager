# Base URL for the Spring Boot REST API (do not include a trailing slash).
BACKEND_API_URL=http://localhost:8081/api/v1

# Gmail SMTP: create a Google App Password; never use your normal Gmail password.
APP_EMAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-account@gmail.com
MAIL_APP_PASSWORD=replace-with-google-app-password
MAIL_FROM=your-account@gmail.com
APP_PLATFORM_ACTIVATION_BASE_URL=https://your-domain.example/activate-admin/index.html
APP_PLATFORM_ACTIVATION_HOURS=24
APP_PLATFORM_ACTIVATION_LINK_RETURN_ENABLED=false
